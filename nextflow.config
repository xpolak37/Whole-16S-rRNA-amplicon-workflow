/*
========================================================================================
    16S PacBio HiFi Profiling Pipeline — Configuration
========================================================================================
*/

params {
    // I/O
    input          = null     // mode 1: samplesheet CSV
    bam            = null     // mode 2: non-demuxed PacBio HiFi BAM
    barcodes       = null     // mode 2: barcode FASTA for lima
    outdir         = './results'
    help           = false

    // Tool selection (axis CSVs + --all override)
    denoiser       = 'dada2'
    classifiers    = 'qnb,qblast,idtaxa,assigntaxonomy'
    all            = false

    // Reference data — null sentinels (validated in main.nf if used)
    hostile_index_dir = null
    phix_fasta        = null
    silva_orient_db   = null
    classifiers_dir   = null

    // Cutadapt primers (HiFi 16S — do not change)
    f_primer       = 'AGRGTTYGATYMTGGCTCAG'   // 27F
    r_primer       = 'RGYTACCTTGTTACGACTT'    // 1492R

    // DADA2 (PacBio-tuned — do not change)
    minQ           = 0
    minLen         = 1000
    maxLen         = 1600
    maxN           = 0
    maxEE          = 'Inf'
    minAbundance   = 0.001

    // Lima
    lima_extra_args = ''

    // Custom summary (carried from sibling)
    custom_summary               = true
    custom_summary_blast         = true
    custom_summary_blast_timeout = 240
    custom_summary_top_overreps  = 10
    custom_summary_blast_db      = '16S_ribosomal_RNA'
    min_reads_threshold          = 10000

    // MultiQC
    multiqc_config    = null
    multiqc_title     = '16S PacBio Profiling Report'
    multiqc_extra_args = ''

    // Resource ceilings
    max_cpus       = 48
    max_memory     = '128.GB'
    max_time       = '48.h'

    singularity_cache_dir = './singularity_cache'
}

singularity {
    enabled      = true
    autoMounts   = true
    cacheDir     = params.singularity_cache_dir
    envWhitelist = 'SINGULARITY_TMPDIR,APPTAINER_TMPDIR,TMPDIR'
    pullTimeout  = '2h'
    runOptions   = '--no-home --env PYTHONNOUSERSITE=1 --env MPLCONFIGDIR=/tmp'
}

executor {
    cpus   = params.max_cpus as int
    memory = params.max_memory
}

process {
    cpus   = { check_max( 2  * task.attempt, 'cpus'   ) }
    memory = { check_max( 6.GB * task.attempt, 'memory') }
    time   = { check_max( 4.h * task.attempt, 'time'  ) }
    errorStrategy = { task.exitStatus in [137,139,140,143] ? 'retry' : 'finish' }
    maxRetries    = 2
    // Default publishDir maps each process to a directory matching its
    // lowercased name. Modules that need a different layout (dada2/<denoiser>,
    // taxonomy/<denoiser>/<classifier>, hostile/, orient/, custom_summary/,
    // pipeline_info/) declare their own publishDir directive in the module
    // file — output values aren't visible to publishDir interpolation, so
    // closures referencing ${denoiser} only work when denoiser is a process
    // input (taxonomy modules) or a literal (dada2 modules).
    publishDir = [ path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" }, mode: 'copy' ]
}

// Clamp requested cpus/memory/time to params.max_*; warn-and-pass-through on parse error
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            def cap = params.max_memory as nextflow.util.MemoryUnit
            return obj.compareTo(cap) == 1 ? cap : obj
        } catch (all) {
            log.warn "max_memory '${params.max_memory}' not parseable; using requested ${obj}"
            return obj
        }
    } else if (type == 'time') {
        try {
            def cap = params.max_time as nextflow.util.Duration
            return obj.compareTo(cap) == 1 ? cap : obj
        } catch (all) {
            log.warn "max_time '${params.max_time}' not parseable; using requested ${obj}"
            return obj
        }
    } else if (type == 'cpus') {
        return Math.min(obj as int, params.max_cpus as int)
    }
    return obj
}
