/*
========================================================================================
    16S PacBio HiFi PROFILING PIPELINE - Configuration File
========================================================================================
*/

/*
========================================================================================
    Cache Directories
========================================================================================
    These directories will store downloaded databases and container images.
    Set them to persistent, shared locations to avoid re-downloading.

    Recommended setup:
    - Use shared filesystem paths accessible to all compute nodes
    - Ensure sufficient storage (classifiers ~ 500 MB, containers ~ 4 GB)
========================================================================================
*/

params {

    ////////////////////////////////////////////////////////////////////////////////////
    // Cache directories
    singularity_cache_dir = './singularity_cache'   // container images cache
    classifiers_dir       = './classifiers'         // QNB / QBLAST / IDTAXA / assignTaxonomy refs
    hostile_index_dir     = './hostile_index'       // pre-downloaded hostile human index
    phix_index            = './hostile_index'       // hostile PhiX index (.mmi)
    silva_orient_db       = './silva_orient/'                    // primer-anchored SILVA db for vsearch --orient
    blast_db_dir          = './blast_db'            // local BLAST databases (16S_ribosomal_RNA)
    scratch_dir           = "${baseDir}/.nf_scratch" // bind-mounted as /tmp inside every container
                                                     // (host /tmp can be tiny - 2 GB on tigra - which
                                                     // makes FastQC's JVM and Singularity sandbox
                                                     // conversions fail). Override per host if needed.

    ////////////////////////////////////////////////////////////////////////////////////
    // Input / Output options
    // Mode 1: samplesheet (--input)        Mode 2: non-demuxed BAM (--bam + --barcodes)
    input    = null
    bam      = null
    barcodes = null
    outdir   = './results'
    help     = false

    ////////////////////////////////////////////////////////////////////////////////////
    // Tool selection (axis CSVs; --all overrides both)
    denoiser    = 'dada2'                                    // dada2 | dada2_nodenoise
    classifiers = 'qnb,qblast,assigntaxonomy'                // any comma subset (idtaxa opt-in: genus-only)
    all         = false

    // Canonical classifier reshaped into the wide, report-ready taxa_table.tsv
    // (taxonomy/<denoiser>/report/). Must be one of the enabled `classifiers`.
    report_classifier = 'qblast'

    ////////////////////////////////////////////////////////////////////////////////////
    // Step toggles
    // PacBio HiFi kits don't spike PhiX (it's an Illumina control), so the PhiX
    // pass is usually a no-op. Default on for safety; set --skip_phix true to
    // skip the step entirely.
    skip_phix   = false

    ////////////////////////////////////////////////////////////////////////////////////
    // Run parameters
    tax_level          = 'asv'   // domain | phylum | class | order | family | genus | species | asv
    run_id             = 'run01'
    metastandard_top_n = 10
    quick              = false
    quick_depth        = 1000

    ////////////////////////////////////////////////////////////////////////////////////
    // Cutadapt parameters (HiFi 16S — do not change)
    f_primer = 'AGRGTTYGATYMTGGCTCAG'   // 27F
    r_primer = 'RGYTACCTTGTTACGACTT'    // 1492R

    ////////////////////////////////////////////////////////////////////////////////////
    // Lima parameters
    lima_extra_args = ''   // e.g. '--hifi-preset SYMMETRIC'

    ////////////////////////////////////////////////////////////////////////////////////
    // DADA2 parameters (PacBio-tuned — do not change)
    minQ         = 0
    minLen       = 1000
    maxLen       = 1600
    maxN         = 0
    maxEE        = 'Inf'
    minAbundance = 0.001     // used by dada2_nodenoise only

    ////////////////////////////////////////////////////////////////////////////////////
    // DADA2 execution mode
    // dada2_split runs filter/denoise as one task per sample instead of a single
    // cohort-level task. dada() uses pool = FALSE, so samples are already
    // denoised independently and the outputs are identical either way. The split
    // exists because the cohort-level script dereplicates every sample before
    // denoising any of them, holding all of those objects in memory at once, so
    // its peak grows with cohort size and eventually exceeds any machine. Set
    // false to fall back to the original bin/dada2_pacbio.R for A/B comparison.
    dada2_split            = true
    dada2_learn_nbases     = 1e8    // learnErrors default; ~0.5 of one PacBio sample
    dada2_learn_randomize  = false  // learnErrors default
    dada2_band_size        = 32     // BAND_SIZE for learnErrors and dada
    dada2_min_fold         = 3.5    // removeBimeraDenovo minFoldParentOverAbundance

    ////////////////////////////////////////////////////////////////////////////////////
    // QIIME NAIVE BAYES
    qiime_naive_bayes_confidence = 0.7   // numeric: backs off to a lower rank when species isn't supported (honest leaf). 'disable' would force a species call on every ASV with no confidence score.

    ////////////////////////////////////////////////////////////////////////////////////
    // QIIME BLAST
    blast_percidentity = 0.99   // species-level cutoff for full-length 16S (Edgar 2018); lower (e.g. 0.987 Yarza, 0.97 Stackebrandt) gives more hits but stops at genus
    blast_minconsensus = 0.51
    // classify-consensus-blast does not parallelise in practice: it runs on a
    // single core regardless of --p-num-threads. Each query is classified
    // independently of the others, so rep-seqs are split into chunks classified
    // by parallel tasks and merged back into ASV order afterwards. Lower this to
    // increase parallelism, raise it to reduce task count; a value at or above
    // the ASV count reproduces the original single-task behaviour.
    blast_chunk_size   = 500

    ////////////////////////////////////////////////////////////////////////////////////
    // Mock community evaluation parameters
    mock_evaluation = false                                                // off by default
    mock_pattern    = 'Mock\\d+'                                           // regex matching mock sample ids
    mock_top_n      = 15
    mock_abundance  = "${projectDir}/composition/mock_asv_abundance.csv"
    mock_taxa       = "${projectDir}/composition/mock_taxa.csv"
    mock_synonyms   = "${projectDir}/composition/genus_synonyms.csv"

    ////////////////////////////////////////////////////////////////////////////////////
    // Custom summary report parameters
    custom_summary               = true
    custom_summary_blast         = true       // best-effort; pipeline never fails on BLAST flake
    custom_summary_blast_timeout = 240        // per-query blastn timeout (seconds)
    custom_summary_top_overreps  = 10
    custom_summary_blast_db      = '16S_ribosomal_RNA'
    min_reads_threshold          = 10000      // samples below this raw read count are flagged

    ////////////////////////////////////////////////////////////////////////////////////
    // MultiQC parameters
    multiqc_config     = null
    multiqc_title      = '16S PacBio Profiling Report'
    multiqc_extra_args = ''

    ////////////////////////////////////////////////////////////////////////////////////
    // Machine profile. These are the ONLY numbers to change when moving to a
    // different host: every process request below is clamped to them by
    // check_max(), so a request can never exceed what the machine actually has
    // and leave the task permanently unschedulable.
    //
    // Check the target host with:  nproc ; free -g
    //
    // These also set how much work runs concurrently. The wall clock on a large
    // cohort is dominated by the per-sample stages, so it is governed by
    // max_memory / per-task memory rather than by any single task's speed --
    // raising max_memory to match the host is usually the biggest available win.
    max_cpus   = 48
    max_memory = '128.GB'
    max_time   = '240.h'
}

executor {
    cpus   = params.max_cpus
    memory = params.max_memory
}

// Clamp a per-process request to the machine profile above (nf-core idiom).
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            return obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1
                 ? params.max_memory as nextflow.util.MemoryUnit : obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            return obj.compareTo(params.max_time as nextflow.util.Duration) == 1
                 ? params.max_time as nextflow.util.Duration : obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj as int, params.max_cpus as int) }
        catch (all) { return obj }
    }
    return obj
}

/*
========================================================================================
    Singularity configuration
========================================================================================
*/

// Ensure the container-side /tmp exists before any task launches. autoMounts
// would otherwise bind the host /tmp, which on some servers (tigra: 2 GB) is
// too small for FastQC's JVM hsperfdata + PNG rendering and for Singularity
// SIF→sandbox conversions when multiple containers run concurrently.
new File(params.scratch_dir).mkdirs()

singularity {
    enabled      = true
    autoMounts   = true
    cacheDir     = params.singularity_cache_dir
    envWhitelist = 'SINGULARITY_TMPDIR,APPTAINER_TMPDIR,TMPDIR'
    pullTimeout  = '2h'
    runOptions   = "--no-home --env PYTHONNOUSERSITE=1 --env MPLCONFIGDIR=/tmp -B ${params.scratch_dir}:/tmp"
}

/*
========================================================================================
    Process configuration
========================================================================================
    All per-process resource requests (container, cpus, memory, time) live here
    so they can be tuned without touching module files. Modules only declare
    structural directives: `tag`, `publishDir` and I/O.
========================================================================================
*/

process {

    // Global defaults
    container     = null
    // A large cohort is a multi-day investment, so one task dying must not throw
    // it away. Resource-related exit codes (OOM kill 137, scheduler timeout
    // 140/143, JVM/BLAS aborts 134/139) retry with escalated resources -- the
    // heavier processes below scale memory and time by task.attempt. Anything
    // else is a genuine bug, so 'finish' lets in-flight work complete and then
    // stops, leaving the run resumable with -resume rather than half-destroyed.
    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 3

    // Resource floor for any process without its own withName block below.
    // Without these, such a process declares no memory at all and Nextflow
    // packs it as if it were free, which over-subscribes the machine.
    cpus          = { check_max( 1,                    'cpus'   ) }
    memory        = { check_max( 8.GB  * task.attempt, 'memory' ) }
    time          = { check_max( 4.h   * task.attempt, 'time'   ) }

    // NOTE ON `time`: the local executor ignores it entirely -- it schedules on
    // cpus and memory only. The generous values below therefore cost nothing
    // when running locally, and exist so this config stays safe if the pipeline
    // is moved to SLURM or similar, where an exceeded wall clock kills the task.
    //
    // `memory` is load-bearing in both cases: Nextflow packs concurrent tasks
    // against the executor budget using the REQUESTED value, never the actual
    // one. An understated request therefore over-subscribes real RAM and invites
    // the kernel OOM killer, and nothing warns you -- so prefer to overstate.

    // Default publishDir maps each process to a directory matching its
    // lowercased name. Modules that need a different layout (dada2/<denoiser>,
    // taxonomy/<denoiser>/<classifier>, hostile/, orient/, custom_summary/,
    // pipeline_info/) declare their own publishDir directive in the module.
    publishDir = [ path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" }, mode: 'copy' ]

    ////////////////////////////////////////////////////////////////////////////////////
    // Input ingest

    withName: 'BAM2FASTQ' {
        cpus      = { check_max( 4, 'cpus'   ) }
        memory    = { check_max( 16.GB * task.attempt, 'memory' ) }
        time      = { check_max( 24.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/pbtk:3.5.0--h9ee0642_0'
    }

    withName: 'LIMA_DEMUX' {
        cpus      = { check_max( 8, 'cpus'   ) }
        memory    = { check_max( 32.GB * task.attempt, 'memory' ) }
        time      = { check_max( 48.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/lima:2.12.0--h9ee0642_1'
    }

    ////////////////////////////////////////////////////////////////////////////////////
    // QC + preprocessing

    withName: 'FASTQC' {
        cpus      = { check_max( 4, 'cpus'   ) }
        memory    = { check_max( 8.GB * task.attempt, 'memory' ) }
        time      = { check_max( 6.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    }

    withName: 'CUTADAPT' {
        cpus      = { check_max( 4, 'cpus'   ) }
        memory    = { check_max( 12.GB * task.attempt, 'memory' ) }
        time      = { check_max( 12.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/cutadapt:4.6--py39hf95cd2a_1'
    }

    withName: 'HOST_REMOVAL' {
        cpus      = { check_max( 8, 'cpus'   ) }
        memory    = { check_max( 32.GB * task.attempt, 'memory' ) }
        time      = { check_max( 24.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/hostile:1.1.0--pyhdfd78af_0'
    }

    withName: 'PHIX_REMOVAL' {
        cpus      = { check_max( 4, 'cpus'   ) }
        memory    = { check_max( 12.GB * task.attempt, 'memory' ) }
        time      = { check_max( 12.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/hostile:1.1.0--pyhdfd78af_0'
    }

     
    withName: 'FASTQ_SYNC'{
        cpus      = { check_max( 4, 'cpus'   ) }
        memory    = { check_max( 8.GB * task.attempt, 'memory' ) }
        time      = { check_max( 6.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/fastp:1.3.3--h43da1c4_0'
    }

    withName: 'VSEARCH_ORIENT' {
        cpus      = { check_max( 4, 'cpus'   ) }
        memory    = { check_max( 12.GB * task.attempt, 'memory' ) }
        time      = { check_max( 12.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/vsearch:2.27.0--h6a68c12_1'
    }

    ////////////////////////////////////////////////////////////////////////////////////
    // Denoising — PacBio DADA2 is the wallclock-heaviest step in the pipeline.
    // 96 h covers large cohorts with `errorEstimationFunction = makeBinnedQualErrfun`.

    withName: 'DADA2_PACBIO' {
        cpus      = { check_max( 16, 'cpus'   ) }
        memory    = { check_max( 64.GB * task.attempt, 'memory' ) }
        time      = { check_max( 96.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/bioconductor-dada2:1.38.0--r45ha27e39d_0'
    }

    // Split DADA2 path.
    //
    // The per-sample stages hold one sample's dereplicated reads, which is on
    // the order of a gigabyte for full-length 16S at typical depth; the
    // double-digit requests below are deliberate headroom, not measurements.
    //
    // cpus here are chosen for THROUGHPUT rather than per-task speed. What sets
    // the wall clock on a large cohort is how many per-sample tasks run at once,
    // which is bounded by max_memory / per-task memory -- so lowering a per-task
    // request can finish the cohort sooner than raising its cpus.
    withName: 'DADA2_FILTER' {
        cpus      = { check_max( 2,                     'cpus'   ) }
        memory    = { check_max( 6.GB  * task.attempt,  'memory' ) }
        time      = { check_max( 8.h   * task.attempt,  'time'   ) }
        container = 'docker://quay.io/biocontainers/bioconductor-dada2:1.38.0--r45ha27e39d_0'
    }

    // Flat in cohort size: reads only until --dada2_learn_nbases is reached,
    // which for full-length PacBio reads is typically under a single sample.
    // On small cohorts this stage is the floor on total runtime.
    withName: 'DADA2_LEARN_ERRORS' {
        cpus      = { check_max( 16,                    'cpus'   ) }
        memory    = { check_max( 48.GB * task.attempt,  'memory' ) }
        time      = { check_max( 72.h  * task.attempt,  'time'   ) }
        container = 'docker://quay.io/biocontainers/bioconductor-dada2:1.38.0--r45ha27e39d_0'
    }

    // One task per sample, and the bulk of the pipeline's total compute.
    withName: 'DADA2_DENOISE' {
        cpus      = { check_max( 4,                     'cpus'   ) }
        memory    = { check_max( 10.GB * task.attempt,  'memory' ) }
        time      = { check_max( 48.h  * task.attempt,  'time'   ) }
        container = 'docker://quay.io/biocontainers/bioconductor-dada2:1.38.0--r45ha27e39d_0'
    }

    // removeBimeraDenovo's consensus vote is cohort-level and scales worse than
    // linearly in sample count, making it the least predictable stage on a large
    // cohort. Budgeted far above expectation deliberately: reaching this point
    // again means redoing all of the denoising.
    withName: 'DADA2_MERGE' {
        cpus      = { check_max( 16,                    'cpus'   ) }
        memory    = { check_max( 64.GB * task.attempt,  'memory' ) }
        time      = { check_max( 168.h * task.attempt,  'time'   ) }
        container = 'docker://quay.io/biocontainers/bioconductor-dada2:1.38.0--r45ha27e39d_0'
    }

    // Emits every raw unique sequence, with no dada() step to collapse them, so
    // its output is far larger than DADA2_DENOISE's and is gzipped. Peak memory
    // is still only one sample's worth.
    withName: 'DADA2_DEREP' {
        cpus      = { check_max( 2,                     'cpus'   ) }
        memory    = { check_max( 12.GB * task.attempt,  'memory' ) }
        time      = { check_max( 12.h  * task.attempt,  'time'   ) }
        container = 'docker://quay.io/biocontainers/bioconductor-dada2:1.38.0--r45ha27e39d_0'
    }

    // Two streaming passes over the per-sample uniques, holding only sequences
    // that can still clear minAbundance. That candidate set is small at typical
    // minAbundance values, but a sufficiently small minAbundance drives the
    // prefilter cutoff to zero and makes this stage hold every raw unique in the
    // cohort -- hence the large request.
    withName: 'DADA2_NODENOISE_MERGE' {
        cpus      = { check_max( 16,                    'cpus'   ) }
        memory    = { check_max( 96.GB * task.attempt,  'memory' ) }
        time      = { check_max( 168.h * task.attempt,  'time'   ) }
        container = 'docker://quay.io/biocontainers/bioconductor-dada2:1.38.0--r45ha27e39d_0'
    }

    withName: 'DADA2_PACBIO_NODENOISE' {
        cpus      = { check_max( 16, 'cpus'   ) }
        memory    = { check_max( 64.GB * task.attempt, 'memory' ) }
        time      = { check_max( 96.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/bioconductor-dada2:1.38.0--r45ha27e39d_0'
    }

    ////////////////////////////////////////////////////////////////////////////////////
    // Taxonomy classifiers

    // Memory here is driven by the size of the sklearn classifier model rather
    // than by cohort size, so it is roughly flat in sample count -- but the peak
    // is substantially higher than the step looks like it should need. The local
    // executor does not enforce requests, so an understated value goes unnoticed
    // until a scheduler kills the task.
    withName: 'QIIME_NAIVE_BAYES' {
        cpus      = { check_max( 8, 'cpus'   ) }
        memory    = { check_max( 64.GB * task.attempt, 'memory' ) }
        time      = { check_max( 24.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/qiime2/amplicon:2026.1'
    }

    // Few cores each: classify-consensus-blast runs single-threaded whatever
    // --p-num-threads says, so parallelism comes from running many chunks side
    // by side rather than from threads inside one task. Chunk count is set by
    // --blast_chunk_size; aim for enough chunks to fill the machine.
    withName: 'QIIME_BLAST_CHUNK' {
        cpus      = { check_max( 2,                     'cpus'   ) }
        memory    = { check_max( 12.GB * task.attempt,  'memory' ) }
        time      = { check_max( 24.h  * task.attempt,  'time'   ) }
        container = 'docker://quay.io/qiime2/amplicon:2026.1'
    }

    withName: 'QIIME_BLAST_MERGE' {
        cpus      = { check_max( 1,                     'cpus'   ) }
        memory    = { check_max( 4.GB  * task.attempt,  'memory' ) }
        time      = { check_max( 2.h   * task.attempt,  'time'   ) }
        container = 'docker://quay.io/biocontainers/pandas:2.2.1'
    }

    withName: 'IDTAXA' {
        cpus      = { check_max( 8, 'cpus'   ) }
        memory    = { check_max( 32.GB * task.attempt, 'memory' ) }
        time      = { check_max( 24.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/bioconductor-decipher:3.6.0--r45h01b2380_0'
    }

    withName: 'ASSIGNTAXONOMY' {
        cpus      = { check_max( 8, 'cpus'   ) }
        memory    = { check_max( 48.GB * task.attempt, 'memory' ) }
        time      = { check_max( 24.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/bioconductor-dada2:1.30.0--r43hf17093f_0'
    }

    ////////////////////////////////////////////////////////////////////////////////////
    // MetaStandard16S + plots

    withName: 'METASTANDARD' {
        cpus      = { check_max( 2, 'cpus'   ) }
        memory    = { check_max( 16.GB * task.attempt, 'memory' ) }
        time      = { check_max( 8.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/pandas:2.2.1'
    }

    withName: 'METASTANDARD_PLOTS' {
        cpus      = { check_max( 2, 'cpus'   ) }
        memory    = { check_max( 16.GB * task.attempt, 'memory' ) }
        time      = { check_max( 8.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/seaborn:0.13.2'
    }

    ////////////////////////////////////////////////////////////////////////////////////
    // Mock evaluation
    // Uses the seaborn biocontainer because seaborn pulls in
    // pandas + numpy + scipy + matplotlib as runtime dependencies,
    // covering everything bin/mock_evaluation.py imports.
    withName: 'MOCK_EVALUATION' {
        cpus      = { check_max( 2, 'cpus'   ) }
        memory    = { check_max( 16.GB * task.attempt, 'memory' ) }
        time      = { check_max( 8.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/seaborn:0.13.2'
    }

    ////////////////////////////////////////////////////////////////////////////////////
    // Custom summary report — three processes because no single biocontainer
    // ships both Python and BLAST+. Parse/render run in the pandas image,
    // BLAST runs in the BLAST+ biocontainer.

    withName: 'CUSTOM_SUMMARY_PARSE' {
        cpus      = { check_max( 2, 'cpus'   ) }
        memory    = { check_max( 16.GB * task.attempt, 'memory' ) }
        time      = { check_max( 8.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/pandas:2.2.1'
    }

    withName: 'CUSTOM_SUMMARY_BLAST' {
        cpus      = { check_max( 2, 'cpus'   ) }
        memory    = { check_max( 8.GB * task.attempt, 'memory' ) }
        time      = { check_max( 8.h  * task.attempt, 'time'   ) }
        container        = 'docker://quay.io/biocontainers/blast:2.15.0--pl5321h6f7f691_1'
        containerOptions = { "--bind ${params.blast_db_dir}" }
        // Best-effort step: never abort the pipeline if BLAST flakes.
        errorStrategy    = 'ignore'
    }

    withName: 'CUSTOM_SUMMARY_RENDER' {
        cpus      = { check_max( 2, 'cpus'   ) }
        memory    = { check_max( 8.GB * task.attempt, 'memory' ) }
        time      = { check_max( 4.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/pandas:2.2.1'
    }

    ////////////////////////////////////////////////////////////////////////////////////
    // MultiQC

    withName: 'MULTIQC' {
        cpus      = { check_max( 2, 'cpus'   ) }
        memory    = { check_max( 32.GB * task.attempt, 'memory' ) }
        time      = { check_max( 8.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/multiqc:1.21--pyhdfd78af_0'
    }

    ////////////////////////////////////////////////////////////////////////////////////
    // Subsampling (--quick mode)

    withName: 'SEQTK_SUBSAMPLE' {
        cpus      = { check_max( 2, 'cpus'   ) }
        memory    = { check_max( 8.GB * task.attempt, 'memory' ) }
        time      = { check_max( 4.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/seqtk:1.4--he4a0461_2'
    }

    ////////////////////////////////////////////////////////////////////////////////////
    // Counts collation

    withName: 'COLLATE_COUNTS' {
        cpus      = { check_max( 1, 'cpus'   ) }
        memory    = { check_max( 8.GB * task.attempt, 'memory' ) }
        time      = { check_max( 4.h  * task.attempt, 'time'   ) }
        container = 'docker://quay.io/biocontainers/pandas:2.2.1'
    }
}

/*
========================================================================================
    Report and trace options
========================================================================================
*/

// Per-run suffix so a new run can never overwrite an earlier run's metrics.
// These files were previously fixed names with overwrite = true, which meant any
// invocation writing into the same --outdir destroyed the previous run's trace,
// report, timeline and DAG -- including `nextflow run main.nf --help`, which
// emits them even though the workflow body never executes. A long run's timings
// are not reproducible, so losing them silently is expensive.
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline {
    enabled   = true
    overwrite = false
    file      = "${params.outdir}/pipeline_info/timeline_${trace_timestamp}.html"
}

report {
    enabled   = true
    overwrite = false
    file      = "${params.outdir}/pipeline_info/report_${trace_timestamp}.html"
}

trace {
    enabled   = true
    overwrite = false
    file      = "${params.outdir}/pipeline_info/trace_${trace_timestamp}.txt"
}

dag {
    enabled   = true
    overwrite = false
    file      = "${params.outdir}/pipeline_info/dag_${trace_timestamp}.svg"
}

manifest {
    name            = '16S-PacBio-HiFi-profiling-pipeline'
    author          = 'Petra Polakovicova & Alise Ponsero'
    description     = 'Nextflow pipeline for PacBio HiFi long-read 16S profiling with DADA2 and four taxonomic classifiers.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10.0'
    version         = '1.0.0'
}
